# Copy to .env and fill in for local development. Never commit the real .env.

# Local dev default is SQLite; swap for the Supabase Postgres connection string
# when working against the shared database, e.g.:
# postgresql+psycopg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=sqlite:///./careergps.db

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173
