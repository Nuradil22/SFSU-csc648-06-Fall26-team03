# Copy to .env and fill in for local development. Never commit the real .env.

# Local dev default is SQLite; swap for the Supabase Postgres connection string
# when working against the shared database (use the session pooler, port 5432), e.g.:
# postgresql+psycopg://<user>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./careergps.db

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call this API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173
# localhost / 127.0.0.1 on any port are also allowed by default, so a local
# frontend can call the deployed API. Set to empty to disable.
# ALLOWED_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# React app URL, used to build shareable portfolio links: <FRONTEND_URL>/p/<token>
FRONTEND_URL=http://localhost:5173
# This API's public URL, used to build URLs for files stored with STORAGE_BACKEND=local
PUBLIC_API_URL=http://localhost:8000

# --- File storage (project images, 3D models) ---
# local    = save under UPLOAD_DIR, served at /uploads (dev only)
# supabase = Supabase Storage (required on Render; its disk is wiped on deploy)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
SUPABASE_URL=
# Supabase dashboard > Project Settings > API > service_role key. Backend only — never expose it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=careergps-media
MAX_IMAGE_MB=10
MAX_MODEL_MB=50

# --- AI career guidance ---
# mock      = rule-based guidance, no API key needed (default for dev)
# anthropic = Claude via the Anthropic API
# openai    = OpenAI via the OpenAI API (e.g. AI_PROVIDER=openai on Render)
# API keys are backend-only secrets: set them in .env / the Render dashboard,
# never in the frontend or in git.
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=120

# Used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Live web research for AI roadmaps and the career chatbot (OpenAI only).
# When true, roadmap generation and messages about courses, programs,
# certificates, or learning resources use OpenAI's web_search tool. Only links
# returned by that search are shown. Each search adds OpenAI cost.
OPENAI_WEB_SEARCH=false
# Optional comma-separated allowlist (subdomains included), e.g.
# sfsu.edu,coursera.org,edx.org. Empty = open web, SFSU and official
# providers preferred.
OPENAI_WEB_SEARCH_DOMAINS=
# Sites never accepted as sources (forums, video sites, catalog mirrors).
OPENAI_WEB_SEARCH_BLOCKED_DOMAINS=courseleaf.com,reddit.com,youtube.com,quora.com
# Check that each researched link opens over valid HTTPS before showing it;
# missing pages, TLS/connection errors, and broken redirects are dropped.
RESOURCE_LINK_CHECK=true
RESOURCE_LINK_CHECK_TIMEOUT=5
# Max searches per request, and how much page text each search adds
# (low | medium | high).
OPENAI_MAX_WEB_SEARCHES=3
OPENAI_WEB_SEARCH_CONTEXT=low
# Reasoning effort and output-token caps (reasoning tokens included) for the
# career assistant; answers longer than the cap are rejected with a clear error.
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS_CHAT=3000
OPENAI_MAX_OUTPUT_TOKENS_ROADMAP=10000

# Per-student limits on billed AI calls.
AI_ROADMAP_GENERATIONS_PER_DAY=5
AI_CHAT_MESSAGES_PER_HOUR=30
